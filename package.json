{
  "name": "auragram",
  "version": "0.3.0",
  "private": true,
  "description": "AuraGram Studio - local photo editor with face-aware skin and lash retouch.",
  "scripts": {
    "test": "node --test tests/unit.test.js tests/vision.test.mjs tests/retouch.test.mjs tests/g1b1.test.mjs tests/lashes.test.mjs tests/exportPreparation.test.mjs tests/history-session.test.js",
    "test:e2e": "node scripts/run-e2e.cjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/utilities.input.css -o src/utilities.css --minify",
    "build": "npm run build:css && node scripts/vendor-ui.cjs",
    "package:site": "node scripts/package-site.cjs",
    "check:site": "node scripts/check-site.cjs",
    "check:live": "node scripts/check-live.cjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@phosphor-icons/web": "2.1.1",
    "@playwright/test": "^1.49.1",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21"
  }
}
